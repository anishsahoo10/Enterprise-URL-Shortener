# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urlshortener
DB_USERNAME=urlapp
DB_PASSWORD=your_secure_password_here
